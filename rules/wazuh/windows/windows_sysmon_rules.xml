
<group name="local,windows,sysmon,">

  <!-- Outbound SSH detection -->
  <rule id="100100" level="5">
    <if_sid>61605</if_sid>
    <field name="win.system.eventID">^3$</field>
    <field name="win.eventdata.image">ssh.exe</field>
    <field name="win.eventdata.protocol">^tcp$</field>
    <field name="win.eventdata.initiated">^true$</field>
    <field name="win.eventdata.destinationPort">^22$</field>
    <description>Sysmon: Outbound SSH connection detected</description>
    <group>sysmon,network_connection,ssh,</group>
  </rule>

  <!-- Outbound HTTPS detection -->
  <rule id="100101" level="5">
    <if_sid>61605</if_sid>
    <field name="win.system.eventID">^3$</field>
    <field name="win.eventdata.protocol">^tcp$</field>
    <field name="win.eventdata.initiated">^true$</field>
    <field name="win.eventdata.destinationPort">^443$</field>
    <description>Sysmon: Outbound HTTPS connection detected</description>
    <group>sysmon,network_connection,https,</group>
  </rule>

</group>
